<Window x:Class="GW2JadeProtocolTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GW2 Jade Protocol Timer"
        Width="270"
        Height="178"
        MinWidth="270"
        MinHeight="178"
        MaxWidth="270"
        MaxHeight="178"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Brush.Surface" Color="#10141B"/>
        <SolidColorBrush x:Key="Brush.Text" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="Brush.Muted" Color="#C9D2DE"/>
        <SolidColorBrush x:Key="Brush.Border" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="Brush.Track" Color="#3A4452"/>
        <SolidColorBrush x:Key="Brush.Idle" Color="#202A36"/>
        <SolidColorBrush x:Key="Brush.Running" Color="#14243A"/>
        <SolidColorBrush x:Key="Brush.RowBorderIdle" Color="#C9D2DE"/>
        <SolidColorBrush x:Key="Brush.RowBorderRunning" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="Brush.RowBorderReady" Color="#FFE27A"/>
        <SolidColorBrush x:Key="Brush.ReadyAccent" Color="#FFE27A"/>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="8"
            Padding="12"
            CornerRadius="14"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="3"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Jade Protocols"
                           Grid.Column="0"
                           Foreground="{StaticResource Brush.Muted}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="QuitButton"
                        Grid.Column="1"
                        Content="Quit"
                        Width="34"
                        Height="22"
                        Margin="0,0,6,0"
                        Padding="0"
                        Foreground="{StaticResource Brush.Text}"
                        Background="{StaticResource Brush.Track}"
                        BorderBrush="{StaticResource Brush.Muted}"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Click="QuitButton_Click"/>
                <Button x:Name="HideButton"
                        Grid.Column="2"
                        Content="X"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Foreground="{StaticResource Brush.Text}"
                        Background="{StaticResource Brush.Track}"
                        BorderBrush="{StaticResource Brush.Muted}"
                        BorderThickness="1"
                        FontSize="11"
                        FontWeight="Bold"
                        Click="HideButton_Click"/>
            </Grid>

            <Button x:Name="OffensiveButton"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    Padding="12,8"
                    HorizontalContentAlignment="Stretch"
                    Background="{StaticResource Brush.Idle}"
                    BorderBrush="{StaticResource Brush.RowBorderIdle}"
                    BorderThickness="1"
                    Click="OffensiveButton_Click"
                    MouseRightButtonDown="OffensiveButton_MouseRightButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Offensive"
                               Foreground="{StaticResource Brush.Text}"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="OffensiveStatusText"
                               Grid.Column="1"
                               Text="+45m"
                               Margin="28,0,0,0"
                               Foreground="{StaticResource Brush.Muted}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </Grid>
            </Button>

            <Button x:Name="DefensiveButton"
                    Grid.Row="2"
                    Padding="12,8"
                    HorizontalContentAlignment="Stretch"
                    Background="{StaticResource Brush.Idle}"
                    BorderBrush="{StaticResource Brush.RowBorderIdle}"
                    BorderThickness="1"
                    Click="DefensiveButton_Click"
                    MouseRightButtonDown="DefensiveButton_MouseRightButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Defensive"
                               Foreground="{StaticResource Brush.Text}"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="DefensiveStatusText"
                               Grid.Column="1"
                               Text="+45m"
                               Margin="28,0,0,0"
                               Foreground="{StaticResource Brush.Muted}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </Grid>
            </Button>
        </Grid>
    </Border>
</Window>
